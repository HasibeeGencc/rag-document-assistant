# Copy this file to .env and fill in your own values. Never commit .env.

# Which LLM provider to use: "groq" or "gemini"
LLM_PROVIDER=groq

# Groq (https://console.groq.com -> API Keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Gemini (optional backup, https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local embedding model (downloaded on first use, runs on your machine)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Where ChromaDB stores its data
CHROMA_DIR=data/chroma

# Largest PDF the API accepts, in megabytes
MAX_UPLOAD_MB=20
